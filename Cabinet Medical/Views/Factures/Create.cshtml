@model Cabinet_Medical.Models.Facture

@{
    ViewData["Title"] = "Nouvelle Facture";
}

<div class="card fade-in">
    <div class="card-header">
        <h4 class="mb-0">
            <i class="bi bi-receipt me-2"></i>Nouvelle Facture
        </h4>
    </div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <h6>Erreurs de validation :</h6>
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Create" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="PatientId" class="form-label">Patient <span class="text-danger">*</span></label>
                    <select name="PatientId" id="patientSelect" class="form-select">
                        <option value="">-- Sélectionner un patient --</option>
                        @if (ViewBag.Patients != null)
                        {
                            @foreach (var patient in ViewBag.Patients as IEnumerable<Cabinet_Medical.Models.Patient>)
                            {
                                var isSelected = Model != null && patient.Id == Model.PatientId;
                                <option value="@patient.Id" selected="@isSelected">@patient.Nom @patient.Prenom (@patient.User?.Email)</option>
                            }
                        }
                    </select>
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState["PatientId"]?.Errors?.Count > 0)
                    {
                        @foreach (var error in ViewData.ModelState["PatientId"]?.Errors)
                        {
                            <span class="text-danger d-block">@error.ErrorMessage</span>
                        }
                    }
                </div>

                <div class="col-md-6 mb-3">
                    <label for="ConsultationId" class="form-label">Consultation <span class="text-danger">*</span></label>
                    <select name="ConsultationId" id="ConsultationId" class="form-select">
                        <option value="">-- Sélectionner une consultation --</option>
                        @if (ViewBag.Consultations != null)
                        {
                            @foreach (var consultation in ViewBag.Consultations as IEnumerable<Cabinet_Medical.Models.Consultation>)
                            {
                                var isSelected = Model != null && consultation.Id == Model.ConsultationId;
                                <option value="@consultation.Id" data-patient="@consultation.DossierMedical?.PatientId" selected="@isSelected">
                                    Consultation du @consultation.DateConsultation.ToString("dd/MM/yyyy") - Dr. @consultation.Medecin?.Nom
                                </option>
                            }
                        }
                    </select>
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState["ConsultationId"]?.Errors?.Count > 0)
                    {
                        @foreach (var error in ViewData.ModelState["ConsultationId"]?.Errors)
                        {
                            <span class="text-danger d-block">@error.ErrorMessage</span>
                        }
                    }
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="Montant" class="form-label">Montant (€) <span class="text-danger">*</span></label>
                    <input name="Montant" id="Montant" type="number" step="0.01" min="0" class="form-control" value="@(Model?.Montant > 0 ? Model.Montant.ToString("F2") : "")" />
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Montant"]?.Errors?.Count > 0)
                    {
                        @foreach (var error in ViewData.ModelState["Montant"]?.Errors)
                        {
                            <span class="text-danger d-block">@error.ErrorMessage</span>
                        }
                    }
                </div>

                <div class="col-md-6 mb-3">
                    <label for="Statut" class="form-label">Statut</label>
                    <select name="Statut" id="Statut" class="form-select">
                        <option value="NonPayee" selected="@(Model?.Statut == "NonPayee" || string.IsNullOrEmpty(Model?.Statut))">Non payée</option>
                        <option value="Payee" selected="@(Model?.Statut == "Payee")">Payée</option>
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-2"></i>Créer
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-2"></i>Annuler
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var patientSelect = document.getElementById('patientSelect');
            var consultationSelect = document.getElementById('ConsultationId');
            var form = document.querySelector('form');

            if (patientSelect) {
                patientSelect.addEventListener('change', function() {
                    const patientId = this.value;
                    
                    if (consultationSelect) {
                        consultationSelect.querySelectorAll('option').forEach(option => {
                            if (option.value === '') {
                                option.style.display = 'block';
                                return;
                            }
                            const optionPatientId = option.getAttribute('data-patient');
                            if (patientId && optionPatientId !== patientId) {
                                option.style.display = 'none';
                            } else {
                                option.style.display = 'block';
                            }
                        });
                    }
                });
            }

            if (form) {
                form.addEventListener('submit', function(e) {
                    var patientId = patientSelect ? patientSelect.value : '';
                    var consultationId = consultationSelect ? consultationSelect.value : '';
                    var montant = document.getElementById('Montant') ? document.getElementById('Montant').value : '';
                    
                    if (!patientId || patientId === '') {
                        e.preventDefault();
                        alert('Veuillez sélectionner un patient.');
                        return false;
                    }
                    
                    if (!consultationId || consultationId === '') {
                        e.preventDefault();
                        alert('Veuillez sélectionner une consultation.');
                        return false;
                    }
                    
                    if (!montant || parseFloat(montant) <= 0) {
                        e.preventDefault();
                        alert('Veuillez saisir un montant valide et supérieur à 0.');
                        return false;
                    }
                    
                    return true;
                });
            }
        });
    </script>
}

