@model IEnumerable<Cabinet_Medical.Models.Facture>

@{
    ViewData["Title"] = "Gestion des Factures";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fade-in" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card fade-in">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-receipt me-2"></i>Factures
            </h4>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-2"></i>Nouvelle facture
            </a>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Date</th>
                            <th>Patient</th>
                            <th>Consultation</th>
                            <th>Montant</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var facture in Model)
                        {
                            <tr>
                                <td><strong>#@facture.Id</strong></td>
                                <td>@facture.DateFacture.ToString("dd/MM/yyyy")</td>
                                <td><strong>@facture.Patient?.Nom @facture.Patient?.Prenom</strong></td>
                                <td>@facture.Consultation?.DateConsultation.ToString("dd/MM/yyyy")</td>
                                <td><strong>@facture.Montant.ToString("C")</strong></td>
                                <td>
                                    @if (facture.Statut == "Payee")
                                    {
                                        <span class="badge badge-success">Payée</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Non payée</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@facture.Id" class="btn btn-sm btn-info" title="Détails">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <!-- EXTEND: Imprimer facture -->
                                    <a asp-action="Imprimer" asp-route-id="@facture.Id" class="btn btn-sm btn-secondary" target="_blank" title="Imprimer">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt" style="font-size: 4rem; color: #ccc;"></i>
                <p class="text-muted mt-3">Aucune facture enregistrée.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Créer la première facture
                </a>
            </div>
        }
    </div>
</div>

