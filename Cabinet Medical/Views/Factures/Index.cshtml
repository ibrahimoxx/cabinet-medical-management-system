@model IEnumerable<Cabinet_Medical.Models.Facture>

@{
    ViewData["Title"] = "Gestion des Factures";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Facturation</h1>
        <p>Suivi de la facturation et des paiements</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nouvelle facture
    </a>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Toutes les factures</h2>
    </div>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Date</th>
                    <th>Patient</th>
                    <th>Consultation</th>
                    <th>Montant</th>
                    <th>Statut</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td><span style="font-weight:700;color:#1E88E5;">#@f.Id</span></td>
                        <td style="white-space:nowrap;">@f.DateFacture.ToString("dd/MM/yyyy")</td>
                        <td style="font-weight:600;">@f.Patient?.Nom @f.Patient?.Prenom</td>
                        <td style="color:#6B7280;">@f.Consultation?.DateConsultation.ToString("dd/MM/yyyy")</td>
                        <td style="font-weight:700;">@f.Montant.ToString("C")</td>
                        <td>
                            @if (f.Statut == "Payee")
                            { <span class="badge badge-green"><span class="badge-dot"></span>Payée</span> }
                            else
                            { <span class="badge badge-red"><span class="badge-dot"></span>Non payée</span> }
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex;justify-content:flex-end;gap:4px;">
                                <a asp-action="Details" asp-route-id="@f.Id" class="btn-tbl-action" title="Détails"><i class="fas fa-eye"></i></a>
                                <a asp-action="Imprimer" asp-route-id="@f.Id" class="btn-tbl-action" target="_blank" title="Imprimer"><i class="fas fa-print"></i></a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center;padding:48px;color:#9CA3AF;">
                            <i class="fas fa-receipt" style="font-size:2rem;display:block;margin-bottom:12px;color:#E5E7EB;"></i>
                            <p style="margin:0 0 12px;">Aucune facture enregistrée</p>
                            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Créer une facture</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
