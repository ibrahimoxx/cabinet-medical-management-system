@model IEnumerable<Cabinet_Medical.Models.Facture>

@{
    ViewData["Title"] = "Mes Factures";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fade-in" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card fade-in">
    <div class="card-header">
        <h4 class="mb-0">
            <i class="bi bi-receipt me-2"></i>Mes Factures
        </h4>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Date</th>
                            <th>Consultation</th>
                            <th>Montant</th>
                            <th>Montant payé</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var facture in Model)
                        {
                            var montantPaye = facture.Paiements?.Sum(p => p.Montant) ?? 0;
                            var reste = facture.Montant - montantPaye;
                            
                            <tr>
                                <td><strong>#@facture.Id</strong></td>
                                <td>@facture.DateFacture.ToString("dd/MM/yyyy")</td>
                                <td>@facture.Consultation?.DateConsultation.ToString("dd/MM/yyyy")</td>
                                <td><strong>@facture.Montant.ToString("C")</strong></td>
                                <td>@montantPaye.ToString("C")</td>
                                <td>
                                    @if (facture.Statut == "Payee" || reste <= 0)
                                    {
                                        <span class="badge badge-success">Payée</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Reste : @reste.ToString("C")</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@facture.Id" class="btn btn-sm btn-info" title="Détails">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <!-- EXTEND: Imprimer facture -->
                                    <a asp-action="Imprimer" asp-route-id="@facture.Id" class="btn btn-sm btn-secondary" target="_blank" title="Imprimer">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                    <!-- EXTEND: Payer facture -->
                                    @if (facture.Statut != "Payee" && reste > 0)
                                    {
                                        <a asp-action="Payer" asp-route-id="@facture.Id" class="btn btn-sm btn-success" title="Payer">
                                            <i class="bi bi-credit-card"></i> Payer
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt" style="font-size: 4rem; color: #ccc;"></i>
                <p class="text-muted mt-3">Aucune facture disponible.</p>
            </div>
        }
    </div>
</div>

