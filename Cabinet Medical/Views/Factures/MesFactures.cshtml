@model IEnumerable<Cabinet_Medical.Models.Facture>

@{
    ViewData["Title"] = "Mes Factures";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <h1>Mes Factures</h1>
        <p>Suivez vos paiements et factures médicales</p>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Historique de facturation</h2>
    </div>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Date</th>
                    <th>Consultation</th>
                    <th>Montant</th>
                    <th>Payé</th>
                    <th>Statut</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    var montantPaye = f.Paiements?.Sum(p => p.Montant) ?? 0;
                    var reste = f.Montant - montantPaye;
                    <tr>
                        <td><span style="font-weight:700;color:#1E88E5;">#@f.Id</span></td>
                        <td style="white-space:nowrap;">@f.DateFacture.ToString("dd/MM/yyyy")</td>
                        <td style="color:#6B7280;white-space:nowrap;">@f.Consultation?.DateConsultation.ToString("dd/MM/yyyy")</td>
                        <td style="font-weight:700;">@f.Montant.ToString("C")</td>
                        <td style="color:#6B7280;">@montantPaye.ToString("C")</td>
                        <td>
                            @if (f.Statut == "Payee" || reste <= 0)
                            {
                                <span class="badge badge-green">
                                    <span class="badge-dot"></span>Payée
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-red">
                                    <span class="badge-dot"></span>Reste : @reste.ToString("C")
                                </span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex;justify-content:flex-end;gap:6px;">
                                <a asp-action="Details" asp-route-id="@f.Id"
                                   class="btn-tbl-action" title="Voir détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Imprimer" asp-route-id="@f.Id"
                                   class="btn-tbl-action" target="_blank" title="Imprimer">
                                    <i class="fas fa-print"></i>
                                </a>
                                @if (f.Statut != "Payee" && reste > 0)
                                {
                                    <a asp-action="Payer" asp-route-id="@f.Id"
                                       class="btn-tbl-action" title="Payer"
                                       style="background:#DCFCE7;border-color:#86EFAC;color:#16A34A;">
                                        <i class="fas fa-credit-card"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center;padding:48px;color:#9CA3AF;">
                            <i class="fas fa-receipt" style="font-size:2rem;display:block;margin-bottom:12px;color:#E5E7EB;"></i>
                            <p style="margin:0;">Aucune facture disponible</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
