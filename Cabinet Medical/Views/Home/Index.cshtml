@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4">

    <div class="col-md-4">
        <div class="card p-4 animate__animated animate__fadeInUp">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted">Patients</h6>
                    <h2 class="fw-bold">124</h2>
                </div>
                <i class="bi bi-people fs-1 text-primary"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-4 animate__animated animate__fadeInUp animate__delay-1s">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted">Rendez-vous</h6>
                    <h2 class="fw-bold">32</h2>
                </div>
                <i class="bi bi-calendar-check fs-1 text-success"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-4 animate__animated animate__fadeInUp animate__delay-2s">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted">Consultations</h6>
                    <h2 class="fw-bold">89</h2>
                </div>
                <i class="bi bi-clipboard2-pulse fs-1 text-danger"></i>
            </div>
        </div>
    </div>

</div>
