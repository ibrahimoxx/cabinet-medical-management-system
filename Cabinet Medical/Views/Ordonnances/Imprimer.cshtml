@model Cabinet_Medical.Models.Ordonnance

@{
    ViewData["Title"] = "Imprimer Ordonnance";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ordonnance - @Model.DateOrdonnance.ToString("dd/MM/yyyy")</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #000; padding-bottom: 20px; }
        .section { margin-bottom: 20px; }
        .section h3 { border-bottom: 1px solid #ccc; padding-bottom: 5px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        table th, table td { padding: 10px; border: 1px solid #ddd; text-align: left; }
        table th { background-color: #f5f5f5; }
        .badge { padding: 5px 10px; border-radius: 4px; font-size: 12px; }
        .footer { margin-top: 30px; text-align: center; font-size: 12px; color: #666; }
    </style>
</head>
<body>
    <div class="header">
        <h1>ORDONNANCE MÉDICALE</h1>
        <p>Cabinet Medical</p>
    </div>

    <div class="section">
        <h3>Informations Patient</h3>
        <p><strong>Nom :</strong> @Model.Consultation?.DossierMedical?.Patient?.Nom @Model.Consultation?.DossierMedical?.Patient?.Prenom</p>
        <p><strong>Date de naissance :</strong> @(Model.Consultation?.DossierMedical?.Patient?.DateNaissance?.ToString("dd/MM/yyyy") ?? "N/A")</p>
    </div>

    <div class="section">
        <h3>Prescription</h3>
        <p><strong>Date :</strong> @Model.DateOrdonnance.ToString("dd/MM/yyyy")</p>
        <p><strong>Médecin prescripteur :</strong> Dr. @Model.Consultation?.Medecin?.Nom @Model.Consultation?.Medecin?.Prenom - @Model.Consultation?.Medecin?.Specialite</p>
    </div>

    <div class="section">
        <h3>Médicaments / Analyses / Radiologies</h3>
        @if (Model.OrdonnanceDetails != null && Model.OrdonnanceDetails.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Dosage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.OrdonnanceDetails)
                    {
                        <tr>
                            <td>@detail.Type</td>
                            <td><strong>@detail.Description</strong></td>
                            <td>@(detail.Dosage ?? "N/A")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>Aucun détail disponible.</p>
        }
    </div>

    <div class="footer">
        <p>Document généré le @DateTime.Now.ToString("dd/MM/yyyy à HH:mm")</p>
        <p>Signature du médecin : _________________________</p>
    </div>

    <script>
        window.onload = function() { window.print(); }
    </script>
</body>
</html>

