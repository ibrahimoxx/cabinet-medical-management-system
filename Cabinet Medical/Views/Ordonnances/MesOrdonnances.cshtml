@model IEnumerable<Cabinet_Medical.Models.Ordonnance>

@{
    ViewData["Title"] = "Mes Ordonnances";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Mes Ordonnances</h1>
        <p>Prescriptions médicales disponibles</p>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Historique des ordonnances</h2>
    </div>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Médecin</th>
                    <th>Consultation</th>
                    <th>Médicaments</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ordonnance in Model)
                {
                    <tr>
                        <td style="font-weight:700;white-space:nowrap;">@ordonnance.DateOrdonnance.ToString("dd/MM/yyyy")</td>
                        <td>Dr. @ordonnance.Consultation?.Medecin?.Nom @ordonnance.Consultation?.Medecin?.Prenom</td>
                        <td style="color:#6B7280;white-space:nowrap;">@ordonnance.Consultation?.DateConsultation.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge badge-blue">@(ordonnance.OrdonnanceDetails?.Count() ?? 0) élément(s)</span>
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex;justify-content:flex-end;gap:6px;">
                                <a asp-action="Details" asp-route-id="@ordonnance.Id"
                                   class="btn-tbl-action" title="Voir les détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Imprimer" asp-route-id="@ordonnance.Id"
                                   class="btn-tbl-action" target="_blank" title="Imprimer">
                                    <i class="fas fa-print"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:48px;color:#9CA3AF;">
                            <i class="fas fa-pills" style="font-size:2rem;display:block;margin-bottom:12px;color:#E5E7EB;"></i>
                            <p style="margin:0;">Aucune ordonnance disponible</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
