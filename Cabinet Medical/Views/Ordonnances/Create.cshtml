@model Cabinet_Medical.Models.Ordonnance

@{
    ViewData["Title"] = "Nouvelle Ordonnance";
}

<div class="card fade-in">
    <div class="card-header">
        <h4 class="mb-0">
            <i class="bi bi-prescription2 me-2"></i>Nouvelle Ordonnance
        </h4>
    </div>
    <div class="card-body">
        @if (ViewBag.Consultation != null)
        {
            <div class="alert alert-info mb-4">
                <strong>Consultation :</strong> @((ViewBag.Consultation as Cabinet_Medical.Models.Consultation).DossierMedical?.Patient?.Nom) 
                @((ViewBag.Consultation as Cabinet_Medical.Models.Consultation).DossierMedical?.Patient?.Prenom)
                - @((ViewBag.Consultation as Cabinet_Medical.Models.Consultation).DateConsultation.ToString("dd/MM/yyyy"))
            </div>
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="consultationId" value="@Model.ConsultationId" />

            <div id="ordonnanceDetails">
                <div class="detail-row mb-3 p-3 border rounded">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Type <span class="text-danger">*</span></label>
                            <select name="types" class="form-select" required>
                                <option value="">-- Type --</option>
                                <option value="Medicament">Médicament</option>
                                <option value="Analyse">Analyse</option>
                                <option value="Radiologie">Radiologie</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Description <span class="text-danger">*</span></label>
                            <input type="text" name="descriptions" class="form-control" required placeholder="Nom du médicament/analyse/radiologie" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Dosage</label>
                            <input type="text" name="dosages" class="form-control" placeholder="Ex: 2x par jour" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-danger btn-sm remove-row">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <button type="button" class="btn btn-secondary" id="addRow">
                    <i class="bi bi-plus-circle me-2"></i>Ajouter un élément
                </button>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-2"></i>Créer l'ordonnance
                </button>
                <a asp-controller="Consultations" asp-action="Details" asp-route-id="@Model.ConsultationId" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-2"></i>Annuler
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('addRow').addEventListener('click', function() {
            const container = document.getElementById('ordonnanceDetails');
            const newRow = container.firstElementChild.cloneNode(true);
            
            // Reset values
            newRow.querySelectorAll('input, select').forEach(input => {
                if (input.type === 'text' || input.tagName === 'SELECT') {
                    input.value = '';
                }
            });
            
            container.appendChild(newRow);
        });

        document.addEventListener('click', function(e) {
            if (e.target.closest('.remove-row')) {
                const rows = document.querySelectorAll('.detail-row');
                if (rows.length > 1) {
                    e.target.closest('.detail-row').remove();
                } else {
                    alert('Au moins un élément est requis.');
                }
            }
        });
    </script>
}

