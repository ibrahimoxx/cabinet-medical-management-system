@model IEnumerable<Cabinet_Medical.Models.Ordonnance>

@{
    ViewData["Title"] = "Ordonnances";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Ordonnances</h1>
        <p>Prescriptions médicales délivrées aux patients</p>
    </div>
</div>

<div class="filter-card">
    <form method="get" action="@Url.Action("Index")">
        <div class="input-group" style="flex:1;max-width:320px;">
            <i class="fas fa-search input-icon"></i>
            <input type="text" name="searchPatient" class="form-control" value="@ViewBag.SearchPatient" placeholder="Rechercher par patient…">
        </div>
        <input type="date" name="date" class="form-control" value="@ViewBag.Date" style="width:160px;">
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Filtrer</button>
        @if (!string.IsNullOrEmpty(ViewBag.SearchPatient?.ToString()) || !string.IsNullOrEmpty(ViewBag.Date?.ToString()))
        {
            <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-times"></i></a>
        }
    </form>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Toutes les ordonnances</h2>
    </div>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Patient</th>
                    <th>Médicaments</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td style="font-weight:700;white-space:nowrap;">@o.DateOrdonnance.ToString("dd/MM/yyyy")</td>
                        <td style="font-weight:600;">
                            @o.Consultation?.DossierMedical?.Patient?.Nom
                            @o.Consultation?.DossierMedical?.Patient?.Prenom
                        </td>
                        <td>
                            <span class="badge badge-blue">@(o.OrdonnanceDetails?.Count() ?? 0) élément(s)</span>
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex;justify-content:flex-end;gap:4px;">
                                <a asp-action="Details" asp-route-id="@o.Id" class="btn-tbl-action" title="Détails"><i class="fas fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@o.Id" class="btn-tbl-action" title="Modifier"><i class="fas fa-edit"></i></a>
                                <a asp-action="Imprimer" asp-route-id="@o.Id" class="btn-tbl-action" target="_blank" title="Imprimer"><i class="fas fa-print"></i></a>
                                <a asp-action="Delete" asp-route-id="@o.Id" class="btn-tbl-action danger" title="Supprimer"
                                   onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette ordonnance ?');"><i class="fas fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" style="text-align:center;padding:48px;color:#9CA3AF;">
                            <i class="fas fa-pills" style="font-size:2rem;display:block;margin-bottom:12px;color:#E5E7EB;"></i>
                            <p style="margin:0;">Aucune ordonnance enregistrée</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
