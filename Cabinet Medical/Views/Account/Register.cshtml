@{
    ViewData["Title"] = "Inscription";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Inscription | Cabinet Médical</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: #F4F6F8; min-height: 100vh; }

        .page-wrap {
            max-width: 700px;
            margin: 48px auto;
            padding: 0 16px 48px;
        }

        .auth-header {
            display: flex; align-items: center; gap: 14px;
            margin-bottom: 32px;
        }
        .brand-icon {
            width: 48px; height: 48px;
            background: linear-gradient(135deg, #1E88E5, #1565C0);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1.3rem;
            box-shadow: 0 4px 14px rgba(30,136,229,.3);
        }
        .brand-text h1 { font-size: 1rem; font-weight: 800; color: #1F2937; margin: 0; }
        .brand-text p  { font-size: .72rem; color: #6B7280; margin: 0; }

        .form-card {
            background: white;
            border-radius: 16px;
            border: 1px solid #E5E7EB;
            box-shadow: 0 1px 4px rgba(0,0,0,.07);
            overflow: hidden;
        }

        .form-card-header {
            background: linear-gradient(135deg, #1E88E5, #1565C0);
            color: white;
            padding: 22px 32px;
        }
        .form-card-header h2 { font-size: 1.25rem; font-weight: 800; margin: 0 0 2px; }
        .form-card-header p  { font-size: .82rem; opacity: .85; margin: 0; }

        .form-card-body { padding: 32px; }

        .section-label {
            font-size: .7rem;
            font-weight: 700;
            color: #9CA3AF;
            text-transform: uppercase;
            letter-spacing: .08em;
            margin: 0 0 14px;
            padding-bottom: 8px;
            border-bottom: 1px solid #F3F4F6;
        }

        .form-group { margin-bottom: 16px; }
        .form-label { font-size: .82rem; font-weight: 600; color: #374151; margin-bottom: 6px; display: block; }
        .required::after { content: ' *'; color: #EF5350; }

        .input-wrap { position: relative; }
        .input-icon {
            position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
            color: #9CA3AF; font-size: .95rem; pointer-events: none;
        }

        .form-control, .form-select {
            width: 100%;
            padding: 10px 13px 10px 38px;
            border: 1.5px solid #E5E7EB;
            border-radius: 9px;
            font-size: .88rem;
            color: #1F2937;
            background: #F9FAFB;
            transition: border-color .2s, box-shadow .2s;
            font-family: 'Inter', sans-serif;
        }
        .form-control.no-icon, .form-select { padding-left: 13px; }
        .form-control:focus, .form-select:focus {
            outline: none;
            border-color: #1E88E5;
            box-shadow: 0 0 0 3px rgba(30,136,229,.12);
            background: #fff;
        }

        .form-hint { font-size: .75rem; color: #9CA3AF; margin-top: 4px; }

        .alert-box {
            background: #FFEBEE;
            border-left: 4px solid #EF5350;
            border-radius: 8px;
            padding: 12px 16px;
            font-size: .85rem;
            color: #C62828;
            display: flex; align-items: center; gap: 10px;
            margin-bottom: 20px;
        }
        .success-box {
            background: #E8F5E9;
            border-left: 4px solid #4CAF50;
            border-radius: 8px;
            padding: 12px 16px;
            font-size: .85rem;
            color: #2E7D32;
            display: flex; align-items: center; gap: 10px;
            margin-bottom: 20px;
        }

        .btn-submit {
            padding: 12px 32px;
            border: none;
            border-radius: 9px;
            font-size: .9rem;
            font-weight: 700;
            color: white;
            background: linear-gradient(135deg, #1E88E5, #1565C0);
            cursor: pointer;
            transition: transform .2s, box-shadow .2s;
            box-shadow: 0 3px 10px rgba(30,136,229,.3);
            display: inline-flex; align-items: center; gap: 8px;
            font-family: 'Inter', sans-serif;
        }
        .btn-submit:hover { transform: translateY(-1px); box-shadow: 0 5px 16px rgba(30,136,229,.4); }

        .btn-back {
            padding: 12px 20px;
            border: 1.5px solid #D1D5DB;
            border-radius: 9px;
            font-size: .9rem;
            font-weight: 600;
            color: #6B7280;
            background: white;
            cursor: pointer;
            transition: all .2s;
            text-decoration: none;
            display: inline-flex; align-items: center; gap: 7px;
            font-family: 'Inter', sans-serif;
        }
        .btn-back:hover { border-color: #9CA3AF; color: #374151; }

        .login-link { text-align: center; margin-top: 20px; font-size: .85rem; color: #6B7280; }
        .login-link a { color: #1E88E5; font-weight: 700; text-decoration: none; }
        .login-link a:hover { text-decoration: underline; }
    </style>
</head>
<body>
<div class="page-wrap animate__animated animate__fadeInUp">

    <!-- Header -->
    <div class="auth-header">
        <div class="brand-icon"><i class="bi bi-hospital-fill"></i></div>
        <div class="brand-text">
            <h1>Gestion Cabinet Médical</h1>
            <p>Créer un compte patient</p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="form-card">
        <div class="form-card-header">
            <h2><i class="bi bi-person-plus-fill me-2"></i>Inscription</h2>
            <p>Remplissez les informations ci-dessous pour créer votre compte</p>
        </div>

        <div class="form-card-body">
            @if (ViewBag.Error != null)
            {
                <div class="alert-box">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @ViewBag.Error
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-box">
                    <i class="bi bi-check-circle-fill"></i>
                    @TempData["SuccessMessage"]
                </div>
            }

            <form method="post" asp-action="Register">
                @Html.AntiForgeryToken()

                <!-- Section 1: Login info -->
                <p class="section-label">Informations de connexion</p>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label required">Nom d'utilisateur</label>
                            <div class="input-wrap">
                                <i class="bi bi-person input-icon"></i>
                                <input type="text" name="username" class="form-control" required />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label required">Email</label>
                            <div class="input-wrap">
                                <i class="bi bi-envelope input-icon"></i>
                                <input type="email" name="email" class="form-control" required />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group mb-4">
                    <label class="form-label required">Mot de passe</label>
                    <div class="input-wrap">
                        <i class="bi bi-lock input-icon"></i>
                        <input type="password" name="password" class="form-control" required minlength="6" />
                    </div>
                    <p class="form-hint">Minimum 6 caractères</p>
                </div>

                <!-- Section 2: Personal info -->
                <p class="section-label">Informations personnelles</p>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label required">Nom</label>
                            <input type="text" name="nom" class="form-control no-icon" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label required">Prénom</label>
                            <input type="text" name="prenom" class="form-control no-icon" required />
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label required">Téléphone</label>
                            <div class="input-wrap">
                                <i class="bi bi-telephone input-icon"></i>
                                <input type="text" name="telephone" class="form-control" required />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Date de naissance</label>
                            <input type="date" name="dateNaissance" class="form-control no-icon" />
                        </div>
                    </div>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label required">Adresse</label>
                    <div class="input-wrap">
                        <i class="bi bi-geo-alt input-icon"></i>
                        <input type="text" name="adresse" class="form-control" required />
                    </div>
                </div>
                <div class="form-group mb-4">
                    <label class="form-label required">Antécédents médicaux</label>
                    <textarea name="antecedentsMedicaux" class="form-control no-icon" rows="3"
                              required placeholder="Décrivez vos antécédents médicaux..."></textarea>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-3 align-items-center">
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-person-check-fill"></i> S'inscrire
                    </button>
                    <a asp-action="Login" class="btn-back">
                        <i class="bi bi-arrow-left"></i> Retour
                    </a>
                </div>

                <div class="login-link">
                    Déjà un compte ? <a asp-action="Login">Se connecter</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
