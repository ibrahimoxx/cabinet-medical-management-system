@model IEnumerable<Cabinet_Medical.Models.Alerte>

@{
    ViewData["Title"] = "Mes Alertes";
}

<div class="card fade-in">
    <div class="card-header">
        <h4 class="mb-0">
            <i class="bi bi-bell-fill me-2"></i>Mes Alertes
        </h4>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="list-group">
                @foreach (var alerte in Model)
                {
                    <div class="list-group-item @(alerte.EstLue ? "" : "border-start border-4 border-primary") mb-2 rounded">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                @if (!alerte.EstLue)
                                {
                                    <span class="badge bg-primary me-2">Nouveau</span>
                                }
                                <h6 class="mb-1">
                                    @if (alerte.Type == "AnnulationRDV")
                                    {
                                        <i class="bi bi-x-circle-fill text-danger me-2"></i>
                                    }
                                    else if (alerte.Type == "RappelRDV")
                                    {
                                        <i class="bi bi-clock-fill text-warning me-2"></i>
                                    }
                                    @alerte.Type
                                </h6>
                                <p class="mb-1">@alerte.Message</p>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@alerte.DateCreation.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            @if (!alerte.EstLue)
                            {
                                <button class="btn btn-sm btn-outline-primary marquer-lue" data-id="@alerte.Id">
                                    <i class="bi bi-check"></i> Marquer comme lue
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-bell-slash" style="font-size: 4rem; color: #ccc;"></i>
                <p class="text-muted mt-3">Aucune alerte.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.marquer-lue').forEach(btn => {
            btn.addEventListener('click', function() {
                const alerteId = parseInt(this.getAttribute('data-id'));
                fetch('/Alertes/MarquerLue', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(alerteId)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    }
                })
                .catch(error => console.error('Erreur:', error));
            });
        });
    </script>
}

