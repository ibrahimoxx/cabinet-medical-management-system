<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Cabinet Médical</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome 6 (icons matching test references) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <!-- Bootstrap Icons (fallback for legacy bi bi-* classes) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Bootstrap 5 (grid + utilities) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Design System -->
    <link rel="stylesheet" href="~/css/modern.css?v=4.0" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

@{
    var role     = Context.Session.GetString("UserRole");
    var username = Context.Session.GetString("Username");
}

@* Redirect to login if not authenticated *@
@if (username == null
    && !Context.Request.Path.Value!.ToLower().Contains("/account/login")
    && !Context.Request.Path.Value!.ToLower().Contains("/account/register"))
{
    <script>window.location.href = '/Account/Login';</script>
}

@if (username != null)
{
    <div class="dashboard-container">

        <!-- ═══════ SIDEBAR ═══════ -->
        <aside class="sidebar" id="sidebar">

            <!-- Brand (matches admin_dashboard code.html) -->
            <div class="sidebar-brand">
                <i class="fas fa-stethoscope"></i>
                <span class="sidebar-brand-text">Gestion Cabinet<br>Médical</span>
            </div>

            <!-- Navigation -->
            <nav class="sidebar-nav">

                <!-- Dashboard (all roles) -->
                <a class="nav-item" asp-controller="Dashboard" asp-action="Index">
                    <div class="nav-icon"><i class="fas fa-columns"></i></div>
                    Tableau de bord
                </a>

                <!-- Mon Profil (all roles) -->
                <a class="nav-item" asp-controller="Profile" asp-action="Index">
                    <div class="nav-icon"><i class="fas fa-user-circle"></i></div>
                    Mon profil
                </a>

                <!-- Alertes (all roles) -->
                <a class="nav-item" id="alertesNavLink" asp-controller="Alertes" asp-action="Index">
                    <div class="nav-icon"><i class="fas fa-bell"></i></div>
                    Mes alertes
                    <span class="ms-auto badge bg-danger rounded-pill" id="alertesSidebarBadge" style="display:none;font-size:.65rem;padding:2px 7px;">0</span>
                </a>

                @if (role == "Admin")
                {
                    <hr class="nav-separator" />
                    <a class="nav-item" asp-controller="Users" asp-action="Index">
                        <div class="nav-icon"><i class="fas fa-users"></i></div>
                        Utilisateurs
                    </a>
                }

                @if (role == "Secretaire")
                {
                    <hr class="nav-separator" />
                    <a class="nav-item" asp-controller="Patients" asp-action="Index">
                        <div class="nav-icon"><i class="fas fa-user-injured"></i></div>
                        Patients
                    </a>
                    <a class="nav-item" asp-controller="RendezVous" asp-action="Index">
                        <div class="nav-icon"><i class="fas fa-calendar-alt"></i></div>
                        Rendez-vous
                    </a>
                    <a class="nav-item" asp-controller="DossierMedicals" asp-action="Index">
                        <div class="nav-icon"><i class="fas fa-folder-open"></i></div>
                        Dossiers médicaux
                    </a>
                    <a class="nav-item" asp-controller="Consultations" asp-action="Index">
                        <div class="nav-icon"><i class="fas fa-stethoscope"></i></div>
                        Consultations
                    </a>
                    <a class="nav-item" asp-controller="Factures" asp-action="Index">
                        <div class="nav-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                        Factures
                    </a>
                }

                @if (role == "Medecin")
                {
                    <hr class="nav-separator" />
                    <a class="nav-item" asp-controller="RendezVous" asp-action="MesRendezVous">
                        <div class="nav-icon"><i class="fas fa-calendar-check"></i></div>
                        Mes rendez-vous
                    </a>
                    <a class="nav-item" asp-controller="Consultations" asp-action="Index">
                        <div class="nav-icon"><i class="fas fa-notes-medical"></i></div>
                        Consultations
                    </a>
                    <a class="nav-item" asp-controller="Ordonnances" asp-action="Index">
                        <div class="nav-icon"><i class="fas fa-prescription"></i></div>
                        Ordonnances
                    </a>
                    <a class="nav-item" asp-controller="DossierMedicals" asp-action="Index">
                        <div class="nav-icon"><i class="fas fa-folder-open"></i></div>
                        Dossiers médicaux
                    </a>
                }

                @if (role == "Patient")
                {
                    <hr class="nav-separator" />
                    <a class="nav-item" asp-controller="RendezVous" asp-action="Create">
                        <div class="nav-icon"><i class="fas fa-calendar-plus"></i></div>
                        Prendre un RDV
                    </a>
                    <a class="nav-item" asp-controller="RendezVous" asp-action="MesRendezVous">
                        <div class="nav-icon"><i class="fas fa-calendar-check"></i></div>
                        Mes rendez-vous
                    </a>
                    <a class="nav-item" asp-controller="DossierMedicals" asp-action="MonDossier">
                        <div class="nav-icon"><i class="fas fa-file-medical"></i></div>
                        Mon dossier
                    </a>
                    <a class="nav-item" asp-controller="Factures" asp-action="MesFactures">
                        <div class="nav-icon"><i class="fas fa-receipt"></i></div>
                        Mes factures
                    </a>
                    <a class="nav-item" asp-controller="Ordonnances" asp-action="MesOrdonnances">
                        <div class="nav-icon"><i class="fas fa-pills"></i></div>
                        Mes ordonnances
                    </a>
                }

            </nav>

            <!-- Logout -->
            <div class="sidebar-footer">
                <a class="nav-item" asp-controller="Account" asp-action="Logout"
                   style="color:rgba(255,255,255,.7)!important;">
                    <div class="nav-icon"><i class="fas fa-sign-out-alt"></i></div>
                    Déconnexion
                </a>
            </div>
        </aside>

        <!-- ═══════ MAIN CONTENT ═══════ -->
        <div class="main-content">

            <!-- TOPBAR -->
            <header class="topbar">
                <span class="topbar-title">@ViewData["Title"]</span>
                <div class="topbar-actions">
                    <!-- Bell -->
                    <a class="topbar-bell" asp-controller="Alertes" asp-action="Index" id="alertesLink">
                        <i class="fas fa-bell"></i>
                        <span class="badge-count" id="alertesBadge">0</span>
                    </a>
                    <!-- User badge -->
                    <span class="user-badge">
                        <i class="fas fa-user"></i>
                        @username
                        <span style="opacity:.6;margin:0 2px">·</span>
                        @role
                    </span>
                </div>
            </header>

            <!-- PAGE BODY -->
            <div class="page-body">
                @RenderBody()
            </div>
        </div>
    </div>
}
else
{
    @* Not logged in – login & register handle their own layout *@
    @RenderBody()
}

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // ── Active sidebar link ────────────────────────────
    (function () {
        const links = document.querySelectorAll('.sidebar .nav-item');
        const current = window.location.pathname.toLowerCase();
        links.forEach(link => {
            const href = (link.getAttribute('href') || '').toLowerCase();
            if (href && href !== '/' && current.includes(href.split('/')[1])) {
                link.classList.add('active');
            }
        });
    })();

    // ── Unread alerts badge ────────────────────────────
    function loadAlertesCount() {
        fetch('/Alertes/GetUnreadCount')
            .then(r => r.json())
            .then(data => {
                const badge = document.getElementById('alertesBadge');
                const sideBadge = document.getElementById('alertesSidebarBadge');
                if (data.count > 0) {
                    if (badge)     { badge.textContent = data.count; badge.style.display = 'block'; }
                    if (sideBadge) { sideBadge.textContent = data.count; sideBadge.style.display = ''; }
                } else {
                    if (badge)     badge.style.display = 'none';
                    if (sideBadge) sideBadge.style.display = 'none';
                }
            })
            .catch(() => {});
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadAlertesCount();
        setInterval(loadAlertesCount, 30000);
    });

    // ── RDV reminders ──────────────────────────────────
    function checkRappelsRDV() {
        fetch('/RendezVous/CheckRappels')
            .then(r => r.json())
            .then(data => {
                if (data.rappels && data.rappels.length > 0) {
                    data.rappels.forEach(function (rappel) {
                        if (Notification.permission === 'granted') {
                            new Notification('Rappel Rendez-vous', { body: rappel.message, icon: '/favicon.ico' });
                        } else if (Notification.permission !== 'denied') {
                            Notification.requestPermission().then(p => {
                                if (p === 'granted')
                                    new Notification('Rappel Rendez-vous', { body: rappel.message, icon: '/favicon.ico' });
                            });
                        }
                    });
                }
            })
            .catch(() => {});
    }

    if ('Notification' in window) {
        Notification.requestPermission();
        setInterval(checkRappelsRDV, 3600000);
        checkRappelsRDV();
    }
</script>

@RenderSection("Scripts", required: false)

</body>
</html>
