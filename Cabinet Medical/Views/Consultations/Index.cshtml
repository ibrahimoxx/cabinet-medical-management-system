@model IEnumerable<Cabinet_Medical.Models.Consultation>

@{
    ViewData["Title"] = "Consultations";
    var role = Context.Session.GetString("UserRole");
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Consultations</h1>
        <p>Historique des consultations médicales</p>
    </div>
    @if (role == "Medecin")
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouvelle consultation
        </a>
    }
</div>

<div class="filter-card">
    <form method="get" action="@Url.Action("Index")">
        <div class="input-group" style="flex:1;max-width:320px;">
            <i class="fas fa-search input-icon"></i>
            <input type="text" name="searchPatient" class="form-control" value="@ViewBag.SearchPatient" placeholder="Rechercher par patient…">
        </div>
        <input type="date" name="date" class="form-control" value="@ViewBag.Date" style="width:160px;">
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Filtrer</button>
        @if (!string.IsNullOrEmpty(ViewBag.SearchPatient?.ToString()) || !string.IsNullOrEmpty(ViewBag.Date?.ToString()))
        {
            <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-times"></i></a>
        }
    </form>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Toutes les consultations</h2>
    </div>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    @if (role == "Secretaire") { <th>Médecin</th> }
                    <th>Patient</th>
                    <th>Diagnostic</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td style="font-weight:700;white-space:nowrap;">@c.DateConsultation.ToString("dd/MM/yyyy HH:mm")</td>
                        @if (role == "Secretaire") { <td>Dr. @c.Medecin?.Nom @c.Medecin?.Prenom</td> }
                        <td style="font-weight:600;">@c.DossierMedical?.Patient?.Nom @c.DossierMedical?.Patient?.Prenom</td>
                        <td style="color:#6B7280;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                            @(c.Diagnostic?.Length > 60 ? c.Diagnostic.Substring(0, 60) + "…" : c.Diagnostic ?? "N/A")
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex;justify-content:flex-end;gap:4px;">
                                <a asp-action="Details" asp-route-id="@c.Id" class="btn-tbl-action" title="Détails"><i class="fas fa-eye"></i></a>
                                @if (role == "Medecin")
                                {
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn-tbl-action" title="Modifier"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Imprimer" asp-route-id="@c.Id" class="btn-tbl-action" target="_blank" title="Imprimer"><i class="fas fa-print"></i></a>
                                    <a asp-controller="Ordonnances" asp-action="Create" asp-route-consultationId="@c.Id" class="btn-tbl-action" title="Créer ordonnance"><i class="fas fa-prescription"></i></a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn-tbl-action danger" title="Supprimer"
                                       onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette consultation ?');"><i class="fas fa-trash"></i></a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:48px;color:#9CA3AF;">
                            <i class="fas fa-clipboard" style="font-size:2rem;display:block;margin-bottom:12px;color:#E5E7EB;"></i>
                            <p style="margin:0 0 12px;">Aucune consultation enregistrée</p>
                            @if (role == "Medecin") {
                                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Créer une consultation</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
