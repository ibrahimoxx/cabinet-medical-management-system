@model Cabinet_Medical.Models.Consultation

@{
    ViewData["Title"] = "Modifier une Consultation";
}

<div class="card fade-in">
    <div class="card-header">
        <h4 class="mb-0">
            <i class="bi bi-pencil-square me-2"></i>Modifier une Consultation
        </h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MedecinId" />

            <div class="mb-3">
                <label asp-for="DossierMedicalId" class="form-label">Dossier Médical <span class="text-danger">*</span></label>
                <select asp-for="DossierMedicalId" class="form-select" required>
                    @foreach (var dossier in ViewBag.DossierMedicals as IEnumerable<Cabinet_Medical.Models.DossierMedical>)
                    {
                        <option value="@dossier.Id" selected="@(dossier.Id == Model.DossierMedicalId)">
                            @dossier.Patient?.Nom @dossier.Patient?.Prenom
                        </option>
                    }
                </select>
                <span asp-validation-for="DossierMedicalId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DateConsultation" class="form-label">Date de consultation <span class="text-danger">*</span></label>
                <input asp-for="DateConsultation" type="datetime-local" class="form-control" required />
                <span asp-validation-for="DateConsultation" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Diagnostic" class="form-label">Diagnostic</label>
                <textarea asp-for="Diagnostic" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Diagnostic" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-2"></i>Enregistrer
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-2"></i>Annuler
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

