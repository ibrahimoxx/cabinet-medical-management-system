@{
    ViewData["Title"] = "Secrétaire Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stats-card primary fade-in">
            <div class="icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <h3>@ViewBag.TotalPatients</h3>
            <p>Patients</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card success fade-in">
            <div class="icon">
                <i class="bi bi-calendar-check-fill"></i>
            </div>
            <h3>@ViewBag.TotalRDV</h3>
            <p>Total Rendez-vous</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card warning fade-in">
            <div class="icon">
                <i class="bi bi-calendar-event-fill"></i>
            </div>
            <h3>@ViewBag.RDVAujourdhui</h3>
            <p>RDV Aujourd'hui</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card danger fade-in">
            <div class="icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <h3>@ViewBag.FacturesNonPayees</h3>
            <p>Factures Non Payées</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="feature-card primary fade-in" onclick="window.location.href='@Url.Action("Index", "Patients")'">
            <div class="feature-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <h5>Gestion des Patients</h5>
            <p class="text-muted">Consulter, ajouter, modifier et supprimer des patients</p>
            <a asp-controller="Patients" asp-action="Index" class="btn btn-primary mt-3">
                <i class="bi bi-arrow-right me-2"></i>Accéder
            </a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="feature-card success fade-in" onclick="window.location.href='@Url.Action("Index", "RendezVous")'">
            <div class="feature-icon">
                <i class="bi bi-calendar-check-fill"></i>
            </div>
            <h5>Gestion des Rendez-vous</h5>
            <p class="text-muted">Planifier, modifier et annuler des rendez-vous</p>
            <a asp-controller="RendezVous" asp-action="Index" class="btn btn-success mt-3">
                <i class="bi bi-arrow-right me-2"></i>Accéder
            </a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="feature-card info fade-in" onclick="window.location.href='@Url.Action("Index", "DossierMedicals")'">
            <div class="feature-icon">
                <i class="bi bi-file-earmark-medical"></i>
            </div>
            <h5>Dossiers Médicaux</h5>
            <p class="text-muted">Consulter et créer des dossiers médicaux</p>
            <a asp-controller="DossierMedicals" asp-action="Index" class="btn btn-info mt-3">
                <i class="bi bi-arrow-right me-2"></i>Accéder
            </a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="feature-card warning fade-in" onclick="window.location.href='@Url.Action("Index", "Factures")'">
            <div class="feature-icon">
                <i class="bi bi-receipt"></i>
            </div>
            <h5>Gestion des Factures</h5>
            <p class="text-muted">Créer et consulter les factures</p>
            <a asp-controller="Factures" asp-action="Index" class="btn btn-warning mt-3">
                <i class="bi bi-arrow-right me-2"></i>Accéder
            </a>
        </div>
    </div>
</div>

