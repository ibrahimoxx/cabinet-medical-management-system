@{
    ViewData["Title"] = "Secrétaire Dashboard";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-header-left">
        <h1>Dashboard Secrétaire</h1>
        <p>Gestion des patients, rendez-vous et facturation</p>
    </div>
</div>

<!-- Stats: 3 cards (matching secretary_dashboard reference) -->
<div class="stats-grid stats-grid-3 mb-4">

    <!-- Card 1: RDV today (blue) -->
    <div class="stat-card" style="background:#BFDBFE;border:none;">
        <div class="stat-icon" style="background:rgba(59,130,246,.25);color:#1D4ED8;width:64px;height:64px;font-size:1.5rem;">
            <i class="fas fa-calendar-alt"></i>
        </div>
        <div class="stat-info">
            <h3 style="font-size:2.25rem;">@ViewBag.RDVAujourdhui</h3>
            <p style="font-size:0.875rem;font-weight:500;color:#1E40AF;">RDV Aujourd'hui</p>
        </div>
    </div>

    <!-- Card 2: New patients (green) -->
    <div class="stat-card" style="background:#A7F3D0;border:none;">
        <div class="stat-icon" style="background:rgba(16,185,129,.25);color:#065F46;width:64px;height:64px;font-size:1.5rem;">
            <i class="fas fa-user-plus"></i>
        </div>
        <div class="stat-info">
            <h3 style="font-size:2.25rem;">@ViewBag.TotalPatients</h3>
            <p style="font-size:0.875rem;font-weight:500;color:#065F46;">Total Patients</p>
        </div>
    </div>

    <!-- Card 3: Unpaid invoices (stone) -->
    <div class="stat-card" style="background:#E7E5E4;border:none;">
        <div class="stat-icon" style="background:rgba(120,113,108,.25);color:#44403C;width:64px;height:64px;font-size:1.5rem;">
            <i class="fas fa-file-invoice"></i>
        </div>
        <div class="stat-info">
            <h3 style="font-size:2.25rem;">@ViewBag.FacturesNonPayees</h3>
            <p style="font-size:0.875rem;font-weight:500;color:#44403C;">Factures en attente</p>
        </div>
    </div>

</div>

<!-- Daily Schedule (2/3) + Pending Payments (1/3) -->
<div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;">

    <!-- Daily Schedule -->
    <div class="card">
        <div class="card-body">
            <div class="card-header">
                <h2 class="card-title">Planning du Jour</h2>
                <a asp-controller="RendezVous" asp-action="Index" style="font-size:.85rem;color:#1E88E5;font-weight:600;text-decoration:none;">Voir tout</a>
            </div>
            <div style="text-align:center;padding:32px 0;color:#9CA3AF;">
                <i class="fas fa-calendar-day" style="font-size:2rem;color:#E3F2FD;"></i>
                <p class="mt-2 mb-3" style="font-size:.875rem;">Aucun rendez-vous aujourd'hui</p>
                <a asp-controller="RendezVous" asp-action="Index" class="btn btn-primary btn-sm">
                    <i class="fas fa-calendar-alt me-1"></i>Gérer les rendez-vous
                </a>
            </div>
        </div>
    </div>

    <!-- Pending Payments -->
    <div class="card">
        <div class="card-body">
            <h2 class="card-title mb-4">Paiements en attente</h2>
            <div style="text-align:center;padding:20px 0;color:#9CA3AF;">
                <i class="fas fa-check-circle" style="font-size:1.5rem;color:#4CAF50;"></i>
                <p class="mt-2 mb-0" style="font-size:.875rem;">Aucun paiement en attente</p>
            </div>
            <div class="mt-4 text-end">
                <a asp-controller="Factures" asp-action="Index" style="font-size:.85rem;color:#1E88E5;font-weight:600;text-decoration:none;">Voir tout</a>
            </div>
        </div>
    </div>

</div>
