@{
    ViewData["Title"] = "Médecin Dashboard";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-header-left">
        <h1>Doctor Dashboard</h1>
        <p>Dr. @Context.Session.GetString("Username") — votre agenda du jour</p>
    </div>
</div>

<!-- Stats: 3 cards -->
<div class="stats-grid stats-grid-3 mb-4">

    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-calendar-day"></i>
        </div>
        <div class="stat-info">
            <p>RDV Aujourd'hui</p>
            <h3>@ViewBag.MesRDVAujourdhui</h3>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#E8F5E9;color:#4CAF50;">
            <i class="fas fa-notes-medical"></i>
        </div>
        <div class="stat-info">
            <p>Consultations</p>
            <h3>@ViewBag.MesConsultations</h3>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:#FFF3E0;color:#FF9800;">
            <i class="fas fa-prescription"></i>
        </div>
        <div class="stat-info">
            <p>Ordonnances</p>
            <h3>@ViewBag.MesOrdonnances</h3>
        </div>
    </div>

</div>

<!-- Agenda (2/3) + Quick Actions (1/3) -->
<div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;">

    <!-- My Agenda card -->
    <div class="table-card">
        <div class="table-card-header">
            <h2 class="table-card-title">
                <i class="fas fa-calendar-alt me-2" style="color:#1E88E5;"></i>Mon Agenda
            </h2>
            <a asp-controller="RendezVous" asp-action="MesRendezVous" style="font-size:.85rem;color:#1E88E5;font-weight:600;text-decoration:none;">Voir tout</a>
        </div>
        <div style="padding:8px 0;">
            <!-- No agenda items? Placeholder message -->
            <div style="padding:24px;text-align:center;color:#9CA3AF;">
                <i class="fas fa-calendar-check" style="font-size:2rem;margin-bottom:12px;color:#E3F2FD;"></i>
                <p style="margin:0;font-size:.875rem;">Aucun rendez-vous prévu aujourd'hui</p>
                <a asp-controller="RendezVous" asp-action="MesRendezVous" class="btn btn-primary btn-sm mt-3">
                    <i class="fas fa-calendar-alt me-1"></i>Voir mes rendez-vous
                </a>
            </div>
        </div>
    </div>

    <!-- Right column -->
    <div style="display:flex;flex-direction:column;gap:16px;">

        <!-- Notifications panel -->
        <div class="card">
            <div class="card-body">
                <h2 class="card-title mb-3">
                    <i class="fas fa-bell me-2" style="color:#FF9800;"></i>Notifications
                </h2>
                <div style="font-size:.875rem;color:#6B7280;text-align:center;padding:12px 0;">
                    <i class="fas fa-check-circle" style="color:#4CAF50;font-size:1.25rem;"></i>
                    <p class="mt-2 mb-0">Aucune notification urgente</p>
                </div>
                <div class="mt-3 text-center">
                    <a asp-controller="Alertes" asp-action="Index" style="font-size:.8rem;color:#1E88E5;text-decoration:none;">Voir toutes les alertes</a>
                </div>
            </div>
        </div>

        <!-- Quick actions -->
        <div class="card">
            <div class="card-body">
                <h2 class="card-title mb-3">Actions Rapides</h2>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <a asp-controller="RendezVous" asp-action="MesRendezVous" class="btn btn-secondary" style="justify-content:flex-start;">
                        <i class="fas fa-calendar-check"></i> Mes rendez-vous
                    </a>
                    <a asp-controller="Consultations" asp-action="Index" class="btn btn-secondary" style="justify-content:flex-start;">
                        <i class="fas fa-notes-medical"></i> Consultations
                    </a>
                    <a asp-controller="Ordonnances" asp-action="Index" class="btn btn-secondary" style="justify-content:flex-start;">
                        <i class="fas fa-prescription"></i> Ordonnances
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
