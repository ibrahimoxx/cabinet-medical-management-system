@model IEnumerable<Cabinet_Medical.Models.Patient>

@{
    ViewData["Title"] = "Annuaire des Patients";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<!-- Page Header (matches annuaire des patients reference) -->
<div class="page-header">
    <div class="page-header-left">
        <h1>Annuaire des Patients</h1>
        <p>@Model.Count() patient(s) enregistré(s) dans le système</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-user-plus"></i>
        Nouveau Patient
    </a>
</div>

<!-- Filter Bar (matches reference: search + status dropdown + filter button) -->
<div class="filter-card">
    <form method="get" action="@Url.Action("Index")">
        <div class="input-group" style="flex:1;max-width:400px;">
            <i class="fas fa-search input-icon"></i>
            <input type="text" name="search" class="form-control"
                   value="@ViewBag.Search"
                   placeholder="Rechercher par nom, prénom, email ou téléphone…">
        </div>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-search"></i> Rechercher
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.Search?.ToString()))
        {
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-times"></i> Effacer
            </a>
        }
    </form>
</div>

<!-- Table Card (matches annuaire des patients reference) -->
<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Liste des patients</h2>
    </div>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Téléphone</th>
                    <th>Date de naissance</th>
                    <th>Statut Dossier</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in Model)
                {
                    var hasDossier = patient.DossierMedical != null;
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:12px;">
                                <div class="avatar-initials">
                                    @patient.Nom.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <div style="font-weight:700;color:#111827;">@patient.Nom @patient.Prenom</div>
                                    <div style="font-size:.75rem;color:#9CA3AF;">@(patient.User?.Email ?? "N/A")</div>
                                </div>
                            </div>
                        </td>
                        <td style="color:#6B7280;font-size:.875rem;">@(patient.Telephone ?? "N/A")</td>
                        <td style="color:#6B7280;font-size:.875rem;">
                            @(patient.DateNaissance?.ToString("dd MMM yyyy") ?? "N/A")
                        </td>
                        <td>
                            @if (hasDossier)
                            {
                                <span class="badge badge-green">
                                    <span class="badge-dot"></span>Dossier Complet
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-gray">
                                    <span class="badge-dot"></span>Pas de Dossier
                                </span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex;justify-content:flex-end;gap:4px;">
                                <a asp-action="Details" asp-route-id="@patient.Id"
                                   class="btn-tbl-action" title="Voir détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@patient.Id"
                                   class="btn-tbl-action" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                @if (!hasDossier)
                                {
                                    <a asp-controller="DossierMedicals" asp-action="Create"
                                       asp-route-patientId="@patient.Id"
                                       class="btn-tbl-action" title="Créer dossier">
                                        <i class="fas fa-folder-plus"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="DossierMedicals" asp-action="Consulter"
                                       asp-route-id="@patient.DossierMedical!.Id"
                                       class="btn-tbl-action" title="Voir dossier">
                                        <i class="fas fa-folder-open"></i>
                                    </a>
                                }
                                <a asp-action="Delete" asp-route-id="@patient.Id"
                                   class="btn-tbl-action danger" title="Supprimer"
                                   onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce patient ?');">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:48px;color:#9CA3AF;">
                            <i class="fas fa-users" style="font-size:2rem;margin-bottom:12px;display:block;color:#E5E7EB;"></i>
                            <p style="margin:0 0 12px;">Aucun patient trouvé</p>
                            <a asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="fas fa-user-plus me-1"></i>Ajouter un patient
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
