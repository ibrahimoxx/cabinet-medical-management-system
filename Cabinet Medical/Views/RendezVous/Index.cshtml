@model IEnumerable<Cabinet_Medical.Models.RendezVous>

@{
    ViewData["Title"] = "Gestion des Rendez-vous";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Rendez-vous</h1>
        <p>Planning et gestion des rendez-vous</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-calendar-plus"></i> Nouveau rendez-vous
    </a>
</div>

<div class="filter-card">
    <form method="get" action="@Url.Action("Index")">
        <div class="input-group" style="flex:1;max-width:220px;">
            <i class="fas fa-user input-icon"></i>
            <input type="text" name="searchPatient" class="form-control" value="@ViewBag.SearchPatient" placeholder="Patient…">
        </div>
        <div class="input-group" style="width:200px;">
            <i class="fas fa-user-md input-icon"></i>
            <input type="text" name="searchMedecin" class="form-control" value="@ViewBag.SearchMedecin" placeholder="Médecin…">
        </div>
        <select name="statut" class="form-control" style="width:160px;">
            <option value="">Tous les statuts</option>
            @if (ViewBag.Statut == "Planifie") { <option value="Planifie" selected>Planifié</option> }
            else { <option value="Planifie">Planifié</option> }
            @if (ViewBag.Statut == "Termine") { <option value="Termine" selected>Terminé</option> }
            else { <option value="Termine">Terminé</option> }
            @if (ViewBag.Statut == "Annule") { <option value="Annule" selected>Annulé</option> }
            else { <option value="Annule">Annulé</option> }
        </select>
        <input type="date" name="date" class="form-control" value="@ViewBag.Date" style="width:160px;">
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Rechercher</button>
        @if (!string.IsNullOrEmpty(ViewBag.SearchPatient?.ToString()) || !string.IsNullOrEmpty(ViewBag.SearchMedecin?.ToString())
          || !string.IsNullOrEmpty(ViewBag.Statut?.ToString()) || !string.IsNullOrEmpty(ViewBag.Date?.ToString()))
        {
            <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-times"></i> Effacer</a>
        }
    </form>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title">Tous les rendez-vous</h2>
    </div>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Heure</th>
                    <th>Patient</th>
                    <th>Médecin</th>
                    <th>Motif</th>
                    <th>Statut</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rdv in Model)
                {
                    <tr>
                        <td style="font-weight:700;">@rdv.DateRdv.ToString("dd/MM/yyyy")</td>
                        <td style="color:#6B7280;">@rdv.HeureRdv.ToString(@"hh\:mm")</td>
                        <td style="font-weight:600;">@rdv.Patient?.Nom @rdv.Patient?.Prenom</td>
                        <td>Dr. @rdv.Medecin?.Nom @rdv.Medecin?.Prenom</td>
                        <td style="color:#6B7280;">@(rdv.Motif ?? "N/A")</td>
                        <td>
                            @if (rdv.Statut == "Planifie")
                            { <span class="badge badge-blue"><span class="badge-dot"></span>Planifié</span> }
                            else if (rdv.Statut == "Termine")
                            { <span class="badge badge-green"><span class="badge-dot"></span>Terminé</span> }
                            else if (rdv.Statut == "Annule")
                            { <span class="badge badge-red"><span class="badge-dot"></span>Annulé</span> }
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex;justify-content:flex-end;gap:4px;">
                                <a asp-action="Details" asp-route-id="@rdv.Id" class="btn-tbl-action" title="Détails"><i class="fas fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@rdv.Id" class="btn-tbl-action" title="Modifier"><i class="fas fa-edit"></i></a>
                                @if (rdv.Statut == "Planifie")
                                {
                                    <a asp-action="Annuler" asp-route-id="@rdv.Id" class="btn-tbl-action danger"
                                       onclick="return confirm('Êtes-vous sûr de vouloir annuler ce rendez-vous ?');" title="Annuler">
                                        <i class="fas fa-times-circle"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center;padding:48px;color:#9CA3AF;">
                            <i class="fas fa-calendar-times" style="font-size:2rem;display:block;margin-bottom:12px;color:#E5E7EB;"></i>
                            <p style="margin:0 0 12px;">Aucun rendez-vous trouvé</p>
                            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-calendar-plus me-1"></i>Planifier un RDV</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
