@model Cabinet_Medical.Models.DossierMedical

@{
    ViewData["Title"] = "Mon Dossier Médical";
}

@if (Model == null)
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i>
        @(TempData["InfoMessage"]?.ToString() ?? "Votre dossier médical n'a pas encore été créé.")
    </div>
    return;
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Mon Dossier Médical</h1>
        <p>Créé le @Model.DateCreation.ToString("dd MMMM yyyy")</p>
    </div>
</div>

<!-- Patient Info + Dossier Info -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;">
    <div class="form-section">
        <div class="form-section-header">
            <i class="fas fa-user-injured"></i>
            Informations du patient
        </div>
        <div style="display:flex;flex-direction:column;gap:12px;">
            <div>
                <span class="profile-info-label">Nom complet</span>
                <p style="margin:4px 0 0;font-weight:700;color:#111827;">@Model.Patient?.Nom @Model.Patient?.Prenom</p>
            </div>
            <div>
                <span class="profile-info-label">Date de naissance</span>
                <p style="margin:4px 0 0;color:#374151;">@(Model.Patient?.DateNaissance?.ToString("dd/MM/yyyy") ?? "N/A")</p>
            </div>
            <div>
                <span class="profile-info-label">Téléphone</span>
                <p style="margin:4px 0 0;color:#374151;">@(Model.Patient?.Telephone ?? "N/A")</p>
            </div>
        </div>
    </div>
    <div class="form-section">
        <div class="form-section-header">
            <i class="fas fa-folder-open"></i>
            Informations du dossier
        </div>
        <div style="display:flex;flex-direction:column;gap:12px;">
            <div>
                <span class="profile-info-label">Date de création</span>
                <p style="margin:4px 0 0;color:#374151;">@Model.DateCreation.ToString("dd/MM/yyyy")</p>
            </div>
            <div>
                <span class="profile-info-label">Remarques</span>
                <p style="margin:4px 0 0;color:#374151;">@(Model.Remarques ?? "Aucune remarque")</p>
            </div>
        </div>
    </div>
</div>

<!-- Consultations history -->
<div class="table-card">
    <div class="table-card-header">
        <h2 class="table-card-title"><i class="fas fa-clipboard-list me-2" style="color:#1E88E5;"></i>Historique des Consultations</h2>
    </div>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Médecin</th>
                    <th>Diagnostic</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.Consultations != null && ((List<Cabinet_Medical.Models.Consultation>)ViewBag.Consultations).Any())
                {
                    foreach (var consultation in (List<Cabinet_Medical.Models.Consultation>)ViewBag.Consultations)
                    {
                        <tr>
                            <td style="font-weight:700;white-space:nowrap;">@consultation.DateConsultation.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>Dr. @consultation.Medecin?.Nom @consultation.Medecin?.Prenom</td>
                            <td style="color:#6B7280;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @(consultation.Diagnostic ?? "N/A")
                            </td>
                            <td style="text-align:right;">
                                <a asp-controller="Consultations" asp-action="Details" asp-route-id="@consultation.Id"
                                   class="btn-tbl-action" title="Voir détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align:center;padding:40px;color:#9CA3AF;">
                            <i class="fas fa-clipboard" style="font-size:2rem;display:block;margin-bottom:12px;color:#E5E7EB;"></i>
                            <p style="margin:0;">Aucune consultation enregistrée</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
