@model Cabinet_Medical.Models.DossierMedical

@{
    ViewData["Title"] = "Mon Dossier Médical";
}

@if (Model == null)
{
    <div class="alert alert-info fade-in">
        <i class="bi bi-info-circle me-2"></i>
        @TempData["InfoMessage"] ?? "Votre dossier médical n'a pas encore été créé."
    </div>
    return;
}

<div class="card fade-in">
    <div class="card-header">
        <h4 class="mb-0">
            <i class="bi bi-file-earmark-medical me-2"></i>Mon Dossier Médical
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-6">
                <h5>Informations du Patient</h5>
                <dl class="row">
                    <dt class="col-sm-4">Nom</dt>
                    <dd class="col-sm-8"><strong>@Model.Patient?.Nom @Model.Patient?.Prenom</strong></dd>

                    <dt class="col-sm-4">Date de naissance</dt>
                    <dd class="col-sm-8">@(Model.Patient?.DateNaissance?.ToString("dd/MM/yyyy") ?? "N/A")</dd>

                    <dt class="col-sm-4">Téléphone</dt>
                    <dd class="col-sm-8">@(Model.Patient?.Telephone ?? "N/A")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5>Dossier Médical</h5>
                <dl class="row">
                    <dt class="col-sm-4">Date de création</dt>
                    <dd class="col-sm-8">@Model.DateCreation.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">Remarques</dt>
                    <dd class="col-sm-8">@(Model.Remarques ?? "Aucune")</dd>
                </dl>
            </div>
        </div>

        <hr />

        <h5 class="mb-3">Historique des Consultations</h5>
        @if (ViewBag.Consultations != null && ((List<Cabinet_Medical.Models.Consultation>)ViewBag.Consultations).Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Médecin</th>
                            <th>Diagnostic</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var consultation in (List<Cabinet_Medical.Models.Consultation>)ViewBag.Consultations)
                        {
                            <tr>
                                <td>@consultation.DateConsultation.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>Dr. @consultation.Medecin?.Nom @consultation.Medecin?.Prenom</td>
                                <td>@(consultation.Diagnostic ?? "N/A")</td>
                                <td>
                                    <a asp-controller="Consultations" asp-action="Details" asp-route-id="@consultation.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">Aucune consultation enregistrée.</p>
        }
    </div>
</div>

