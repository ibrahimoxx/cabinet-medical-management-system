@model IEnumerable<Cabinet_Medical.Models.User>

@{
    ViewData["Title"] = "Gestion des utilisateurs";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>
            <i class="bi bi-people"></i> Utilisateurs
        </h4>

        <!-- EXTEND: Ajouter utilisateur -->
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Ajouter utilisateur
        </a>
    </div>

    <!-- FILTRES DE RECHERCHE -->
    <div class="mb-4 p-3 bg-light rounded">
        <form method="get" action="@Url.Action("Index")" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small text-muted">Rechercher</label>
                <input type="text" name="search" class="form-control form-control-sm" 
                       value="@ViewBag.Search" placeholder="Username ou email">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Rôle</label>
                <select name="role" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    @if (ViewBag.Role == "Admin")
                    {
                        <option value="Admin" selected>Admin</option>
                    }
                    else
                    {
                        <option value="Admin">Admin</option>
                    }
                    @if (ViewBag.Role == "Medecin")
                    {
                        <option value="Medecin" selected>Médecin</option>
                    }
                    else
                    {
                        <option value="Medecin">Médecin</option>
                    }
                    @if (ViewBag.Role == "Secretaire")
                    {
                        <option value="Secretaire" selected>Secrétaire</option>
                    }
                    else
                    {
                        <option value="Secretaire">Secrétaire</option>
                    }
                    @if (ViewBag.Role == "Patient")
                    {
                        <option value="Patient" selected>Patient</option>
                    }
                    else
                    {
                        <option value="Patient">Patient</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Statut</label>
                <select name="statut" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    @if (ViewBag.Statut == "Actif")
                    {
                        <option value="Actif" selected>Actif</option>
                    }
                    else
                    {
                        <option value="Actif">Actif</option>
                    }
                    @if (ViewBag.Statut == "Inactif")
                    {
                        <option value="Inactif" selected>Inactif</option>
                    }
                    else
                    {
                        <option value="Inactif">Inactif</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-sm me-2">
                    <i class="bi bi-search me-1"></i>Rechercher
                </button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(ViewBag.Search) || !string.IsNullOrEmpty(ViewBag.Role) || !string.IsNullOrEmpty(ViewBag.Statut))
        {
            <div class="mt-2">
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Réinitialiser
                </a>
                <small class="text-muted ms-2">
                    <i class="bi bi-funnel me-1"></i>Filtres actifs
                </small>
            </div>
        }
    </div>

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Statut</th>
                <th style="width: 180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Actif</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactif</span>
                        }
                    </td>
                    <td>
                        <!-- EXTEND: Modifier -->
                        <a asp-action="Edit" asp-route-id="@user.Id"
                           class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <!-- EXTEND: Désactiver -->
                        @if (user.Role != "Admin")
{
    <a asp-action="ToggleStatus" asp-route-id="@user.Id"
       class="btn btn-sm btn-secondary">
        <i class="bi bi-power"></i>
    </a>

    <a asp-action="Delete" asp-route-id="@user.Id"
       class="btn btn-sm btn-danger"
       onclick="return confirm('Confirmer la suppression ?');">
        <i class="bi bi-trash"></i>
    </a>
}
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
