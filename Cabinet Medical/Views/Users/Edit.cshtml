@model Cabinet_Medical.Models.User

@{
    ViewData["Title"] = "Modifier utilisateur";
}

<div class="page-hdr mb-4">
    <div class="page-hdr-title">
        <h1><i class="bi bi-pencil-square me-2 text-primary"></i>Modifier l'utilisateur</h1>
        <p>@Model.Username — @Model.Role</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="card fade-in-up">
    <div class="card-header primary-header">
        <span><i class="bi bi-pencil-fill me-2"></i>Informations du compte</span>
    </div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <ul class="mb-0 ps-3">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Nom d'utilisateur</label>
                    <input class="form-control" value="@Model.Username" disabled style="background:var(--gray-100);color:var(--gray-500);" />
                    <input type="hidden" asp-for="Username" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:.8rem;"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Role" class="form-label">Rôle</label>
                    @if (Model.Role == "Admin")
                    {
                        <input class="form-control" value="Admin" disabled style="background:var(--gray-100);color:var(--gray-500);" />
                        <input type="hidden" asp-for="Role" />
                        <small class="text-muted">Le rôle Admin ne peut pas être modifié</small>
                    }
                    else
                    {
                        <select asp-for="Role" class="form-select">
                            <option value="Secretaire">Secrétaire</option>
                            <option value="Medecin">Médecin</option>
                            <option value="Patient">Patient</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger" style="font-size:.8rem;"></span>
                    }
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check">
                        @if (Model.Role == "Admin")
                        {
                            <input asp-for="IsActive" class="form-check-input" checked disabled />
                            <input type="hidden" asp-for="IsActive" value="true" />
                            <label class="form-check-label" style="font-weight:600;">Toujours actif (Admin)</label>
                        }
                        else
                        {
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label" style="font-weight:600;">Compte actif</label>
                        }
                    </div>
                </div>
            </div>

            <hr style="border-color:var(--gray-200);margin-bottom:24px;" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle-fill"></i> Enregistrer
                </button>
                <a asp-action="Index" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
