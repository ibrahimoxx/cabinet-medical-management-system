@model Cabinet_Medical.Models.User

@{
    ViewData["Title"] = "Modifier mon profil";
}

<div class="card p-4">
    <h4 class="mb-4">
        <i class="bi bi-pencil-square"></i> Modifier mon profil
    </h4>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <!-- COMMON USER INFO -->
        <div class="mb-3">
            <label class="form-label">Nom d'utilisateur</label>
            <input class="form-control" value="@Model.Username" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <hr />

        <!-- PATIENT -->
        @if (Model.Role == "Patient" && Model.Patient != null)
        {
            <h5>Informations Patient</h5>

            <div class="mb-3">
                <label class="form-label">Nom</label>
                <input asp-for="Patient.Nom" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Prénom</label>
                <input asp-for="Patient.Prenom" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Téléphone</label>
                <input asp-for="Patient.Telephone" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Adresse</label>
                <input asp-for="Patient.Adresse" class="form-control" />
            </div>
        }

        <!-- MEDECIN -->
        @if (Model.Role == "Medecin" && Model.Medecin != null)
        {
            <h5>Informations Médecin</h5>

            <div class="mb-3">
                <label class="form-label">Nom</label>
                <input asp-for="Medecin.Nom" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Prénom</label>
                <input asp-for="Medecin.Prenom" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Téléphone</label>
                <input asp-for="Medecin.Telephone" class="form-control" />
            </div>
        }

        <!-- SECRETAIRE -->
        @if (Model.Role == "Secretaire" && Model.Secretaire != null)
        {
            <h5>Informations Secrétaire</h5>

            <div class="mb-3">
                <label class="form-label">Nom</label>
                <input asp-for="Secretaire.Nom" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Prénom</label>
                <input asp-for="Secretaire.Prenom" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Téléphone</label>
                <input asp-for="Secretaire.Telephone" class="form-control" />
            </div>
        }

        <hr />

        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Enregistrer
        </button>

        <a asp-action="Index" class="btn btn-secondary ms-2">
            Annuler
        </a>
    </form>
</div>

